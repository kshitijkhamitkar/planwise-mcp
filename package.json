{
  "name": "planwise-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "PlanWise MCP — sales & demand planning tools for AI assistants",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/index.js",
    "seed": "tsx --env-file=.env scripts/seedDatabase.ts",
    "smoke": "tsx --env-file=.env scripts/smokeTools.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "mongoose": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
