# Local Docker Mongo (default)
MONGODB_URI=mongodb://127.0.0.1:27017/planwise

# stdio = local MCP clients | http = remote ChatGPT / hosted deploy
MCP_TRANSPORT=stdio

LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# For ChatGPT "No authentication": set MCP_AUTH_MODE=none on the host
# For Bearer/API key clients: MCP_AUTH_MODE=api_key + API_KEY=...
MCP_AUTH_MODE=api_key
API_KEY=change-me-to-a-long-random-secret

# Deprecated alias for MCP_AUTH_MODE=none
ALLOW_INSECURE_HTTP=false
